{
  "name": "@WEB_CW/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "ts-node-dev --rs ./src/index.ts",
    "build": "rimraf ./dist && tsc --build ./tsconfig.json",
    "start": "node ./dist/index.js",
    "types": "tsc --noEmit --project ./tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:clear-dev-data": "ts-node prisma/reset-dev-data.ts",
    "db:reset-dev-data": "ts-node prisma/reset-dev-data.ts && prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "2.8.13",
    "@types/express": "4.17.17",
    "@types/lodash": "^4.17.24",
    "@types/node": "20.5.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@trpc/server": "10.37.1",
    "cors": "2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "lodash": "^4.18.1",
    "pg": "^8.16.3",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  }
}
